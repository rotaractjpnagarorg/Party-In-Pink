{
  "name": "@pip/functions",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "description": "Party In Pink 5.0 Cloud Functions 2nd Gen",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node22 --format=esm --external:firebase-admin --external:firebase-functions --external:zod --external:exceljs --external:@google-cloud/vision --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "seed:admin": "tsx src/scripts/seedAdmin.ts",
    "seed:event": "tsx src/scripts/seedEvent.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@google-cloud/vision": "^6.1.0",
    "exceljs": "^4.4.0",
    "firebase-admin": "^13.1.0",
    "firebase-functions": "^6.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
